# Set these in Vercel → Project → Settings → Environment Variables (not in the code).
# See PUBLISHING.md for step-by-step instructions.

# Password for melmiit.com/admin (checked on the server only)
ADMIN_PASSWORD=choose_a_long_password

# GitHub fine-grained token with "Contents: Read and write" on the repository
GITHUB_TOKEN=github_pat_xxx

# Optional
GITHUB_REPO=omiahi/melmiit
GITHUB_BRANCH=main
